#include <winver.h>
1 ICON "amberwave.ico"
1 24 "server.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,9,1,0
PRODUCTVERSION 0,9,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704B0"
    BEGIN
      VALUE "CompanyName", "The Amberwave contributors"
      VALUE "FileDescription", "Amberwave Server"
      VALUE "ProductName", "Amberwave"
      VALUE "ProductVersion", AW_VERSION_A
      VALUE "LegalCopyright", "AGPL-3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x407, 1200
  END
END
