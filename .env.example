# Amberwave – the few settings Docker needs. Everything else is configured in the app (Settings).
# Copy this file to ".env" next to docker-compose.yml and adjust the paths. Never share your .env.
# Every other option (German, with explanations): .env.reference

# Your music collection. Amberwave only reads it until you allow writing in Settings → Library & automation.
MUSIK_PFAD=/path/to/your/music

# Where Amberwave keeps its own data: database, cover cache, keys and backups (an SSD is best).
APPDATA_PFAD=/path/to/appdata/amberwave

# Port of the web app: http://<server>:9950
APP_PORT=9950

# Optional: user and group that own your music (Unraid: 99 and 100). Empty = detected automatically.
PUID=
PGID=

# Optional, only for Usenet downloads (off by default): the folder where SABnzbd puts finished music.
# DOWNLOAD_PFAD=/path/to/downloads/complete/music
