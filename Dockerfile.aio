# Amberwave All-in-One (ghcr.io/lfrank95/amberwave-aio): das normale Amberwave-Image plus MariaDB 11.8 LTS und cloudflared
# in einem Container – für den Unraid-Store und alle, die keinen Compose-Stack wollen. Gebaut vom Workflow „Docker image“
# aus dem gerade gebauten App-Image derselben Version (BASIS); monatlich neu, damit MariaDB-Sicherheitsupdates ankommen.
#
# Ein Ordner für alles, was bleiben soll: /appdata (Unraid: /mnt/user/appdata/amberwave) mit db/, cache/, backups/.
ARG BASIS=ghcr.io/lfrank95/amberwave:beta
FROM cloudflare/cloudflared:latest AS cloudflared
FROM ${BASIS}

# MariaDB 11.8 LTS aus Debian 13 (Sicherheitsupdates über den monatlichen Neubau)
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends mariadb-server mariadb-client procps \
    && rm -rf /var/lib/apt/lists/* /var/lib/mysql/* \
    && mariadbd --version

# cloudflared (Apache-2.0) für den Fernzugriff – startet erst, wenn in Amberwave ein Tunnel angelegt wurde
COPY --from=cloudflared /usr/local/bin/cloudflared /usr/local/bin/cloudflared

ENV AMBERWAVE_AIO=1 \
    DB_HOST=127.0.0.1 \
    AIO_DB_PFAD=/appdata/db \
    PFAD_CACHE=/appdata/cache \
    PFAD_BACKUPS=/appdata/backups \
    TUNNEL_ZIEL=http://127.0.0.1:80 \
    TUNNEL_CONTAINER=localhost

LABEL org.opencontainers.image.title="Amberwave (All-in-One)" \
      org.opencontainers.image.description="Self-hosted music server – app, MariaDB 11.8 LTS and Cloudflare Tunnel in one container"

# Stoppen braucht etwas Zeit (Datenbank sauber herunterfahren): docker run --stop-timeout 60 bzw. in der Unraid-Vorlage gesetzt
STOPSIGNAL SIGTERM
