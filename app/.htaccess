# Allgemeine Härtung
AddType font/woff2 .woff2
Options -Indexes -MultiViews
ServerSignature Off
CGIPassAuth On

# Dotfiles, Datenbank-/Backup-/Log-Dateien nie ausliefern
<FilesMatch "^\.|\.(env|sql|gz|log|bak|md|zip|sh|dist|lock|json\.tmp)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Authorization-Kopfzeile (Geräte-Schlüssel der Apps) an PHP durchreichen
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # JSON-API v1
    RewriteRule ^api/v1/(.*)$ api/index.php?pfad=$1 [QSA,L]

    # Interne Ordner nie direkt aufrufbar
    RewriteRule ^(includes|migrations|scripts|bin|klang|i18n)(/|$) - [F,L]

    # Single-Page-App: alles, was keine Datei ist, landet bei index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Textdateien und API-Antworten komprimieren (spart im Mobilnetz grob drei Viertel)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    # Oberflächen-Dateien immer kurz beim Server nachfragen (ETag) – nach einem Update sofort aktuell
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache"
        # Mit Versionsparameter (?v=…, ändert sich bei jeder Änderung der Datei): ein Jahr direkt vom Gerät, keine Rückfrage
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)v=/"
    </FilesMatch>
    <FilesMatch "\.(svg|png)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    # Schriften: der Dateiname trägt die Fassung (-v1) – ein Jahr direkt vom Gerät
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache"
        Header set Service-Worker-Allowed "/"
    </FilesMatch>
</IfModule>
